# ═══════════════════════════════════════════════════════════════════════════════
# Beauty Care by Nabila Lahore — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file as .env.local and fill in the values for your deployment.
# Each variable is project-specific and completely isolated from other projects.
# NEVER share these values with other projects or commit actual secrets to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── APPLICATION ───
NEXT_PUBLIC_APP_NAME="Beauty Care by Nabila Lahore"
NEXT_PUBLIC_APP_URL="https://nabilalahore.com"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ─── SITE CONFIGURATION ───
NEXT_PUBLIC_SITE_URL="https://nabilalahore.com"
NEXT_PUBLIC_SITE_NAME="Beauty Care by Nabila Lahore"
NEXT_PUBLIC_SITE_DESCRIPTION="Luxury Salon & Bridal Studio — M.M. Alam Road, Gulberg III, Lahore"

# ─── CONTACT INFORMATION ───
NEXT_PUBLIC_PHONE="+92-300-0000000"
NEXT_PUBLIC_WHATSAPP="+923000000000"
NEXT_PUBLIC_EMAIL="hello@nabilalahore.com"
NEXT_PUBLIC_ADDRESS="M.M. Alam Road, Gulberg III, Lahore, Pakistan"

# ─── NEXTAUTH (Generate with: openssl rand -base64 32) ───
NEXTAUTH_URL="https://nabilalahore.com"
NEXTAUTH_SECRET=""

# ─── FIREBASE CLIENT (Create a new Firebase project at console.firebase.google.com) ───
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ─── FIREBASE ADMIN SDK (Generate service account key from Firebase Console) ───
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─── SANITY CMS (Create project at sanity.io/manage) ───
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
SANITY_API_VERSION="2024-01-01"

# ─── CLOUDINARY (Create account at cloudinary.com) ───
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="nabila-lahore-uploads"

# ─── DATABASE (Prisma SQLite for development / PostgreSQL for production) ───
DATABASE_URL="file:./db/custom.db"

# ─── VERCEL DEPLOYMENT (Set via Vercel CLI or Dashboard) ───
VERCEL_URL=""
VERCEL_PROJECT_ID=""
VERCEL_ORG_ID=""

# ─── ADMIN ACCESS ───
ADMIN_EMAIL="admin@nabilalahore.com"
ADMIN_ROLE="super-admin"

# ─── BOOKING SYSTEM ───
BOOKING_CONFIRMATION_PREFIX="NBL"
BOOKING_MAX_ADVANCE_DAYS="30"
BOOKING_SLOTS_START="10:00"
BOOKING_SLOTS_END="20:00"
BOOKING_SLOT_INTERVAL="60"

# ─── SECURITY (Generate with: openssl rand -base64 32) ───
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
CSRF_SECRET=""

# ─── SOCIAL MEDIA ───
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/nabilalahore"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/nabilalahore"
NEXT_PUBLIC_TIKTOK_URL="https://tiktok.com/@nabilalahore"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@nabilalahore"

# ─── SEO / VERIFICATION ───
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_YANDEX_VERIFICATION=""

# ─── ANALYTICS ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# ─── WEBHOOKS ───
WEBHOOK_BOOKING_CONFIRMATION_SECRET=""
